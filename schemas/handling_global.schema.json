{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S-Senna — constantes de direção (handling_global.json)",
  "description": "Doc 03 §12.2. Constantes globais de 'feeling' da física; editáveis pelo painel F2. Faixas iguais às de HandlingGlobals.RANGES.",
  "type": "object",
  "required": ["schema", "schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "handling_global" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "grip_min": { "type": "number", "minimum": 0.5, "maximum": 2.5 },
    "grip_max": { "type": "number", "minimum": 0.5, "maximum": 3.0 },
    "peak_slip_deg": { "type": "number", "minimum": 2, "maximum": 20 },
    "rear_grip_factor": { "type": "number", "minimum": 0.6, "maximum": 1.4 },
    "handbrake_grip_factor": { "type": "number", "minimum": 0.1, "maximum": 1.0 },
    "steer_deg_min": { "type": "number", "minimum": 10, "maximum": 50 },
    "steer_deg_max": { "type": "number", "minimum": 10, "maximum": 50 },
    "steer_falloff_kmh": { "type": "number", "minimum": 40, "maximum": 400 },
    "steer_speed": { "type": "number", "minimum": 1, "maximum": 20 },
    "suspension_freq_front": { "type": "number", "minimum": 0.8, "maximum": 4.0 },
    "suspension_freq_rear": { "type": "number", "minimum": 0.8, "maximum": 4.0 },
    "damping_ratio": { "type": "number", "minimum": 0.1, "maximum": 1.2 },
    "antiroll": { "type": "number", "minimum": 0, "maximum": 2 },
    "suspension_travel_m": { "type": "number", "minimum": 0.05, "maximum": 0.4 },
    "com_height_m": { "type": "number", "minimum": 0.15, "maximum": 0.8 },
    "yaw_inertia_factor": { "type": "number", "minimum": 0.5, "maximum": 3.0 },
    "roll_inertia_factor": { "type": "number", "minimum": 0.5, "maximum": 4.0 },
    "downforce_ratio_200": { "type": "number", "minimum": 0, "maximum": 1.5 },
    "rolling_resistance": { "type": "number", "minimum": 0, "maximum": 0.05 },
    "brake_decel_g_min": { "type": "number", "minimum": 0.4, "maximum": 2.0 },
    "brake_decel_g_max": { "type": "number", "minimum": 0.4, "maximum": 2.5 },
    "brake_bias_front": { "type": "number", "minimum": 0.3, "maximum": 0.9 },
    "drive_efficiency": { "type": "number", "minimum": 0.5, "maximum": 1.0 },
    "traction_factor": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
    "gear_spread": { "type": "number", "minimum": 1.5, "maximum": 6.0 },
    "shift_time_s": { "type": "number", "minimum": 0, "maximum": 1 },
    "upshift_rpm_frac": { "type": "number", "minimum": 0.6, "maximum": 1.0 },
    "downshift_rpm_frac": { "type": "number", "minimum": 0.2, "maximum": 0.8 },
    "idle_rpm": { "type": "number", "minimum": 400, "maximum": 2000 },
    "tire_force_height": { "type": "number", "minimum": 0, "maximum": 1 },
    "stability": { "type": "number", "minimum": 0, "maximum": 1 },
    "drift_assist": { "type": "number", "minimum": 0, "maximum": 1 },
    "countersteer": { "type": "number", "minimum": 0, "maximum": 1 },
    "max_drift_deg": { "type": "number", "minimum": 10, "maximum": 80 },
    "nitro_accel": { "type": "number", "minimum": 0, "maximum": 15 },
    "nitro_refill_per_s": { "type": "number", "minimum": 0, "maximum": 1 },
    "auto_right_strength": { "type": "number", "minimum": 0, "maximum": 30 }
  }
}
