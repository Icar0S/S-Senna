{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S-Senna — pista (track.json)",
  "description": "Doc 03 §11. A cena fica em godot/game/tracks/<slug>/.",
  "type": "object",
  "required": ["schema", "schema_version", "id", "display_name_key", "scene", "layouts"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "track" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "id": { "$ref": "common.schema.json#/$defs/track_id" },
    "display_name_key": { "type": "string", "minLength": 1 },
    "scene": { "type": "string", "pattern": "^res://.+\\.tscn$" },
    "time_of_day": { "type": "string" },
    "weather": { "type": "string" },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "node"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/token" },
          "type": { "enum": ["circuit", "sprint", "drag", "drift"] },
          "node": { "type": "string", "minLength": 1 },
          "default_laps": { "type": "integer", "minimum": 1, "maximum": 50 },
          "reversible": { "type": "boolean" }
        }
      }
    }
  }
}
