{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S-Senna — perfil de som do motor (sound.json)",
  "description": "Doc 03 §10.",
  "type": "object",
  "required": ["schema", "schema_version", "id", "loops"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "sound_profile" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "id": { "$ref": "common.schema.json#/$defs/sound_id" },
    "loops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "rpm"],
        "additionalProperties": false,
        "properties": {
          "file": { "$ref": "common.schema.json#/$defs/relative_path" },
          "rpm": { "type": "integer", "minimum": 0, "maximum": 20000 },
          "load": { "enum": ["any", "on", "off"] }
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/relative_path" }
    }
  }
}
