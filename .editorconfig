root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# GDScript e arquivos do Godot usam tabulação (padrão do editor e do gdformat).
[*.{gd,gdshader,gdshaderinc}]
indent_style = tab
indent_size = 4

[*.{tscn,tres,godot,cfg,import}]
indent_style = unset
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.sh]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# Código de terceiros: não reformatar.
[godot/addons/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
